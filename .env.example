# Copy this file to ".env" (same folder as package.json) and fill in ONE key.
# NEVER share or commit the real .env file. It is already listed in .gitignore.

# ---- Option A: Google Gemini (has a free tier, no credit card needed) ----
# Get a key: https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=
# Model name. If you get a "model not available" error, open Google AI Studio,
# pick a Flash model your key can use, and paste its exact name here.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Option B: Anthropic Claude (paid, pay-as-you-go) ----
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Which one to use: gemini or anthropic. If empty, Waii uses whichever key is filled in.
AI_PROVIDER=

# ---- Optional settings ----
PORT=3001
RATE_LIMIT_PER_MIN=20
